# =========================
# MYSQL CONTAINER
# =========================

MYSQL_DATABASE=tea_cake_shop
MYSQL_ROOT_PASSWORD=replace_with_a_strong_database_password

# =========================
# SPRING DATABASE
# =========================

DB_URL=jdbc:mysql://mysql:3306/tea_cake_shop?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=replace_with_a_strong_database_password

# =========================
# JWT
# =========================

JWT_SECRET=replace_with_base64_encoded_32_byte_secret
JWT_ISSUER=tea-cake-shop
JWT_EXPIRATION_SECONDS=900

# =========================
# REFRESH TOKEN
# =========================

REFRESH_TOKEN_EXPIRATION_SECONDS=2592000

# =========================
# CLOUDINARY
# =========================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =========================
# SEEDED ADMIN
# =========================

ADMIN_FULL_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_PHONE=0900000000
STAFF_FULL_NAME=Staff
STAFF_EMAIL=staff@teacakeshop.com
STAFF_PASSWORD=replace_with_a_strong_staff_password
STAFF_PHONE=0900000001

# =========================
# JPA
# =========================

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# =========================
# SERVER
# =========================

SERVER_PORT=8080
